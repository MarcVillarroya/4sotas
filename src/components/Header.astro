---
/**
 * Header compartido. `aria-current="page"` solo en la ruta exacta de la página actual.
 * Todos los enlaces pasan por `url()`: la base de Pages va incluida.
 */
import { MARCA, SECCION, url } from '../lib/rutas.ts';

interface Props {
  actual?: '/' | '/oros/';
}

const { actual } = Astro.props;

const enlaces = [
  { href: '/', etiqueta: 'Inicio', exacta: '/' as const },
  { href: '/oros/', etiqueta: SECCION, exacta: '/oros/' as const },
  { href: '/#criterio', etiqueta: 'Criterio editorial', exacta: null },
];
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href={url('/')}>
      <img src={url('/assets/mark.svg')} width="40" height="44" alt="" decoding="async" />
      {actual === '/oros/' ? `${MARCA} / OROS` : MARCA.toUpperCase()}
      <span class="sr-only">, inicio</span>
    </a>
    <nav aria-label="Principal">
      {
        enlaces.map((e) => (
          <a href={url(e.href)} aria-current={actual && e.exacta === actual ? 'page' : undefined}>
            {e.etiqueta}
          </a>
        ))
      }
    </nav>
  </div>
</header>
