---
/**
 * Header compartido. `aria-current="page"` se deriva de la ruta real: solo la sección
 * más específica que contiene la página actual queda marcada.
 * Todos los enlaces pasan por `url()`: la base de Pages va incluida.
 */
import { BASE, MARCA, SECCION, CANAL_YOUTUBE, url } from '../lib/rutas.ts';

const rutaActual = (() => {
  const p = Astro.url.pathname;
  const sinBase = BASE && p.startsWith(BASE) ? p.slice(BASE.length) : p;
  return sinBase === '' ? '/' : sinBase;
})();

const enlaces = [
  { href: '/', etiqueta: 'Inicio', seccion: '/' },
  { href: '/oros/', etiqueta: SECCION, seccion: '/oros/' },
  { href: '/oros/videos/', etiqueta: 'Vídeos', seccion: '/oros/videos/' },
  { href: '/oros/herramientas/', etiqueta: 'Herramientas', seccion: '/oros/herramientas/' },
  { href: '/oros/glosario/', etiqueta: 'Glosario', seccion: '/oros/glosario/' },
];

const seccionActiva =
  [...enlaces]
    .filter((e) => e.seccion !== '/' && (rutaActual === e.seccion || rutaActual.startsWith(e.seccion)))
    .sort((a, b) => b.seccion.length - a.seccion.length)[0]?.seccion ?? (rutaActual === '/' ? '/' : null);

const enOros = rutaActual.startsWith('/oros/');
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="logo" href={url('/')}>
      <img src={url('/assets/mark.svg')} width="40" height="44" alt="" decoding="async" />
      {enOros ? `${MARCA} / OROS` : MARCA.toUpperCase()}
      <span class="sr-only">, inicio</span>
    </a>
    <nav class="desktop-nav" aria-label="Principal">
      {
        enlaces.map((e) => (
          <a href={url(e.href)} aria-current={rutaActual === e.href ? 'page' : undefined} class:list={{ 'section-active': seccionActiva === e.seccion }}>
            {e.etiqueta}
          </a>
        ))
      }
    </nav>
    <a class="header-channel" href={CANAL_YOUTUBE} target="_blank" rel="noopener"><span class="channel-long">Canal en </span>YouTube <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en otra pestaña)</span></a>
    <details class="mobile-nav">
      <summary>Menú</summary>
      <nav aria-label="Principal móvil">
        {enlaces.map(e => <a href={url(e.href)} aria-current={rutaActual === e.href ? 'page' : undefined}>{e.etiqueta}</a>)}
      </nav>
    </details>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach(menu => {
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>
