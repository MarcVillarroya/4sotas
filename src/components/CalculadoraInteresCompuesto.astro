---
/**
 * Calculadora de interés compuesto · interfaz interactiva.
 *
 * Se renderiza desde `pages/oros/herramientas/[slug].astro` cuando la ficha es la de
 * interés compuesto. La ruta no es un archivo fijo a propósito: así la página aparece
 * exactamente cuando la ficha es visible (`visibles()`), igual que el resto de plantillas,
 * y un borrador no puede filtrarse al build público.
 *
 * La página es HTML estático: el resultado inicial se calcula en el build con el mismo
 * motor puro (`src/lib/calculadora.ts`), de modo que sin JavaScript se ve un ejemplo
 * completo, la tabla y la metodología. El `<script>` retira la salida al editar y calcula
 * al enviar el formulario: no hay envío a servidor, ni cookies, ni peticiones de terceros.
 *
 * Textos visibles: `src/lib/calculadora-presentacion.ts`, probado en
 * `tests/calculadora-presentacion.test.ts`. Aquí solo hay estructura, ids y estilos.
 * La tabla HTML es la fuente de verdad del resultado. El SVG resume las mismas filas y
 * nunca es el único sitio donde está el dato.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Herramienta from '../layouts/Herramienta.astro';
import { duracionLegible } from '../lib/format.ts';
import {
  FRECUENCIAS,
  LIMITES,
  calcularInteresCompuesto,
  filasAnuales,
  formatearEuros,
  type EntradaCalculo,
} from '../lib/calculadora.ts';
import {
  DESTINOS_APRENDER,
  SUPUESTOS_CLAVE,
  filasVisibles,
  metricasVisibles,
  miles,
  resumenEntrada,
} from '../lib/calculadora-presentacion.ts';
import { svgEvolucion } from '../lib/calculadora-svg.ts';
import { url } from '../lib/rutas.ts';

interface Props {
  ficha: CollectionEntry<'herramientas'>;
}

const { ficha } = Astro.props;

/** Ejemplo por defecto, verificado en docs/CALCULADORA.md §5 (vector V5). */
const DEFECTO: EntradaCalculo = {
  capitalInicial: 1000,
  aportacionPeriodica: 100,
  anios: 10,
  meses: 0,
  rentabilidadAnual: 5,
  frecuencia: 'mensual',
  momentoAportacion: 'fin',
  inflacionAnual: null,
};

const inicial = calcularInteresCompuesto(DEFECTO);
if (!inicial.ok) throw new Error(`Ejemplo por defecto inválido: ${inicial.errores[0]?.mensaje ?? 'sin detalle'}`);
const ejemplo = inicial.resultado;
const ejemploFilas = filasAnuales(ejemplo.tabla);
const ejemploMetricas = metricasVisibles(ejemplo);
const ejemploTabla = filasVisibles(ejemploFilas);

/**
 * Ejemplos verificados que se publican en la metodología. Se calculan en el build con el
 * mismo motor, así que el texto no puede envejecer respecto al código; los vectores están
 * fijados (y comprobados con Decimal) en tests/calculadora.ts y docs/CALCULADORA.md §5.
 */
const EJEMPLOS: { titulo: string; entrada: EntradaCalculo; nota: string }[] = [
  {
    titulo: 'Un capital único: 1.000 € al 5 % anual durante 10 años',
    entrada: { ...DEFECTO, aportacionPeriodica: 0, frecuencia: 'anual' },
    nota: 'Sin aportaciones, capitalizar cada mes o cada año da lo mismo: el 5 % es la tasa anual equivalente.',
  },
  {
    titulo: 'Aportación al final: 200 € al mes durante 20 años al 5 % anual',
    entrada: { ...DEFECTO, capitalInicial: 0, aportacionPeriodica: 200, anios: 20 },
    nota: 'Se aportan 48.000 €; el resto sale de los intereses.',
  },
  {
    titulo: 'El mismo caso con un 3 % de inflación',
    entrada: { ...DEFECTO, capitalInicial: 0, aportacionPeriodica: 200, anios: 20, inflacionAnual: 3 },
    nota: 'En euros de hoy el resultado puede quedar por debajo de lo aportado: la inflación también juega.',
  },
];

const ejemplos = EJEMPLOS.map((ejemploPublicado) => {
  const respuesta = calcularInteresCompuesto(ejemploPublicado.entrada);
  if (!respuesta.ok) throw new Error(`Ejemplo publicado inválido: ${ejemploPublicado.titulo}`);
  return { ...ejemploPublicado, resultado: respuesta.resultado };
});

/** Enlaces educativos con el título real de la colección; si falta una entrada, no se pinta. */
const [articulos, videos, terminosGlosario] = await Promise.all([
  getCollection('articulos'),
  getCollection('videos'),
  getCollection('glosario'),
]);

const aprender = DESTINOS_APRENDER.flatMap((destino) => {
  if (destino.coleccion === 'articulos') {
    const entrada = articulos.find((a) => a.data.slug === destino.slug);
    return entrada ? [{ ...destino, titulo: entrada.data.titulo, detalle: '' }] : [];
  }
  if (destino.coleccion === 'videos') {
    const entrada = videos.find((v) => v.data.slug === destino.slug);
    return entrada ? [{ ...destino, titulo: entrada.data.titulo, detalle: duracionLegible(entrada.data.duracion_iso) }] : [];
  }
  const entrada = terminosGlosario.find((g) => g.data.slug === destino.slug);
  return entrada ? [{ ...destino, titulo: entrada.data.termino, detalle: '' }] : [];
});
---

<Herramienta ficha={ficha} calcula={ficha.data.estado_implementacion !== 'no-implementada'}>
  <p class="v2-calc-intro">
    Calcula cuánto tendrías al final si partes de un capital, vas aportando lo mismo cada periodo y eliges tú la
    rentabilidad. Debajo verás, separado, cuánto has puesto y cuánto han generado los intereses.
  </p>

  <form id="formulario-calculo" novalidate aria-describedby="ayuda-formulario">
    <p class="hint" id="ayuda-formulario">
      Escribe tus cifras; los ajustes son opcionales. Nada de lo que escribas sale de esta página.
    </p>

    <fieldset class="v2-calc-group">
      <legend>1 · Con cuánto empiezas</legend>
      <div class="fields">
        <div class="field">
          <label for="capitalInicial">Capital inicial <span class="v2-unit">€</span></label>
          <input
            id="capitalInicial"
            name="capitalInicial"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            enterkeyhint="next"
            value={String(DEFECTO.capitalInicial)}
            aria-describedby="ayuda-capitalInicial error-capitalInicial"
          />
          <p class="hint" id="ayuda-capitalInicial">Lo que ya tienes hoy. De 0 a {miles(LIMITES.capitalMax)} €.</p>
          <p class="error" id="error-capitalInicial" hidden></p>
        </div>

        <div class="field">
          <label for="aportacionPeriodica">Aportación <span class="v2-unit">€ por periodo</span></label>
          <input
            id="aportacionPeriodica"
            name="aportacionPeriodica"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            enterkeyhint="next"
            value={String(DEFECTO.aportacionPeriodica)}
            aria-describedby="ayuda-aportacionPeriodica error-aportacionPeriodica"
          />
          <p class="hint" id="ayuda-aportacionPeriodica">
            Lo que añades cada periodo (cada mes, si eliges capitalización mensual). De 0 a {miles(LIMITES.aportacionMax)} €.
          </p>
          <p class="error" id="error-aportacionPeriodica" hidden></p>
        </div>
      </div>
    </fieldset>

    <fieldset class="v2-calc-group">
      <legend>2 · Durante cuánto tiempo</legend>
      <div class="fields">
        <div class="field">
          <label for="anios">Años</label>
          <input
            id="anios"
            name="anios"
            type="text"
            inputmode="numeric"
            autocomplete="off"
            enterkeyhint="next"
            value={String(DEFECTO.anios)}
            aria-describedby="ayuda-plazo error-anios error-plazo"
          />
          <p class="hint" id="ayuda-plazo">Número entero de 0 a {LIMITES.aniosMax}. Los meses sueltos van aparte.</p>
          <p class="error" id="error-anios" hidden></p>
        </div>

        <div class="field">
          <label for="meses">Meses sueltos</label>
          <select id="meses" name="meses" aria-describedby="ayuda-meses error-meses error-plazo">
            {
              Array.from({ length: 12 }, (_, m) => (
                <option value={String(m)} selected={m === DEFECTO.meses}>
                  {m} {m === 1 ? 'mes' : 'meses'}
                </option>
              ))
            }
          </select>
          <p class="hint" id="ayuda-meses">Se suman a los años. El plazo total debe completar un periodo entero.</p>
          <p class="error" id="error-meses" hidden></p>
        </div>
      </div>
      <p class="error" id="error-plazo" hidden></p>
    </fieldset>

    <fieldset class="v2-calc-group">
      <legend>3 · Qué rentabilidad quieres probar</legend>
      <div class="fields">
        <div class="field">
          <label for="rentabilidadAnual">Rentabilidad anual <span class="v2-unit">%</span></label>
          <input
            id="rentabilidadAnual"
            name="rentabilidadAnual"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            enterkeyhint="next"
            value={String(DEFECTO.rentabilidadAnual)}
            aria-describedby="ayuda-rentabilidadAnual error-rentabilidadAnual"
          />
          <p class="hint" id="ayuda-rentabilidadAnual">
            Es tu hipótesis, no una promesa. Un 5 % significa un 5 % al año, se capitalice cada mes o cada año. De{' '}
            {LIMITES.tasaMin} % a {LIMITES.tasaMax} %.
          </p>
          <p class="error" id="error-rentabilidadAnual" hidden></p>
        </div>

        <div class="field">
          <label for="frecuencia">Cada cuánto se abonan los intereses</label>
          <select id="frecuencia" name="frecuencia" aria-describedby="ayuda-frecuencia error-frecuencia">
            {
              FRECUENCIAS.map((f) => (
                <option value={f.clave} selected={f.clave === DEFECTO.frecuencia}>
                  {f.etiqueta} ({f.periodosPorAnio} {f.periodosPorAnio === 1 ? 'vez' : 'veces'} al año)
                </option>
              ))
            }
          </select>
          <p class="hint" id="ayuda-frecuencia">Marca cada cuánto se suman los intereses al capital y, por tanto, cada cuánto aportas.</p>
          <p class="error" id="error-frecuencia" hidden></p>
        </div>

        <div class="field full">
          <fieldset class="v2-calc-inner">
            <legend class="legend-inline">¿Cuándo entra cada aportación?</legend>
            <div class="radio-row">
              <label for="momento-fin">
                <input
                  id="momento-fin"
                  type="radio"
                  name="momentoAportacion"
                  value="fin"
                  checked={DEFECTO.momentoAportacion === 'fin'}
                />
                Al final de cada periodo
              </label>
              <label for="momento-inicio">
                <input
                  id="momento-inicio"
                  type="radio"
                  name="momentoAportacion"
                  value="inicio"
                  checked={DEFECTO.momentoAportacion === 'inicio'}
                />
                Al inicio de cada periodo
              </label>
            </div>
            <p class="hint" id="ayuda-momentoAportacion">
              Al inicio, la aportación genera intereses en el periodo en que entra; al final, no.
            </p>
            <p class="error" id="error-momentoAportacion" hidden></p>
          </fieldset>
        </div>
      </div>
    </fieldset>

    <fieldset class="v2-calc-group">
      <legend>4 · Opcional: euros de hoy</legend>
      <div class="fields">
        <div class="field full">
          <label for="inflacionAnual">Inflación anual <span class="v2-unit">%</span></label>
          <input
            id="inflacionAnual"
            name="inflacionAnual"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            enterkeyhint="done"
            value=""
            aria-describedby="ayuda-inflacionAnual error-inflacionAnual"
          />
          <p class="hint" id="ayuda-inflacionAnual">
            Déjalo vacío para no calcular el valor real. Si lo rellenas (de {LIMITES.inflacionMin} % a {LIMITES.inflacionMax} %),
            verás el capital final en euros de hoy.
          </p>
          <p class="error" id="error-inflacionAnual" hidden></p>
        </div>
      </div>
    </fieldset>

    <div class="actions">
      <button class="button" type="submit">Calcular</button>
    </div>
    <p class="hint">
      Si cambias un dato, el resultado se oculta. Pulsa Calcular para verlo de nuevo. No se envía nada.
    </p>
    <noscript>
      <p class="honest">
        Tu navegador no está ejecutando el cálculo: verás un ejemplo completo con su tabla, pero no tus propias cifras.
        La fórmula, los supuestos y los límites están igualmente a la vista.
      </p>
    </noscript>
  </form>

  <Fragment slot="ejemplos">
    <ul>
      {
        ejemplos.map((e) => (
          <li>
            <strong>{e.titulo}</strong>: {formatearEuros(e.resultado.capitalFinal)} de capital final,{' '}
            {formatearEuros(e.resultado.aportado)} aportados y {formatearEuros(e.resultado.ganancia)} de intereses
            {e.resultado.valorReal === null
              ? '.'
              : `; en euros de hoy, ${formatearEuros(e.resultado.valorReal)}.`}{' '}
            {e.nota}
          </li>
        ))
      }
    </ul>
    <p class="hint">
      Estas cifras se recalculan cada vez que publicamos la página, con la misma fórmula que usa el formulario.
    </p>
  </Fragment>

  <Fragment slot="resultado">
    <section class="calc-result v2-calc-result" aria-labelledby="resultado-herramienta">
      <p class="eyebrow">Resultado</p>
      <h2 id="resultado-herramienta" tabindex="-1" style="font-size:var(--text-h3)">Capital final</h2>
      <p class="big-number" id="capital-final">{formatearEuros(ejemplo.capitalFinal)}</p>
      <p class="hint" id="resumen-entrada">{resumenEntrada(DEFECTO, ejemplo)}</p>

      <dl class="metrics">
        {
          ejemploMetricas.map((metrica) => (
            <div>
              <dt>{metrica.etiqueta}</dt>
              <dd>
                <span class="v2-calc-metric-value" id={metrica.id}>
                  {metrica.valor}
                </span>
                <span class="v2-calc-metric-help">{metrica.ayuda}</span>
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="v2-calc-honest">
        Esto no es una previsión: es lo que sale si la tasa se mantiene igual todo el plazo y no hay comisiones ni
        impuestos.
      </p>

      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" id="estado-calculo">
        Resultado calculado con los valores del formulario.
      </p>

      <p class="v2-calc-notice" id="aviso-resultado" hidden></p>

      <div class="chart" id="grafico">
        <Fragment set:html={svgEvolucion(ejemploFilas)} />
        <p class="hint">
          Barra clara: lo aportado. Barra dorada: el capital si la rentabilidad se mantiene. Los datos exactos están en la
          tabla.
        </p>
      </div>

      <details class="v2-calc-assumptions">
        <summary>Qué asume esta cifra</summary>
        <dl>
          {
            SUPUESTOS_CLAVE.map((supuesto) => (
              <div>
                <dt>{supuesto.titulo}</dt>
                <dd>{supuesto.texto}</dd>
              </div>
            ))
          }
        </dl>
      </details>
    </section>

    <div class="table-wrap calc-table" tabindex="0" role="region" aria-label="Evolución anual de la simulación">
      <table id="tabla-evolucion">
        <caption>Evolución al cierre de cada año, con los supuestos de la simulación.</caption>
        <thead>
          <tr>
            <th scope="col">Año</th>
            <th scope="col">Aportado (€)</th>
            <th scope="col">Interés acumulado (€)</th>
            <th scope="col">Capital (€)</th>
          </tr>
        </thead>
        <tbody id="tabla-evolucion-cuerpo">
          {
            ejemploTabla.map((fila) => (
              <tr>
                <th scope="row">{fila.anio}</th>
                <td>{fila.aportado}</td>
                <td>{fila.interes}</td>
                <td>{fila.capital}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <section class="v2-calc-learn" aria-labelledby="aprender-titulo">
      <h2 id="aprender-titulo" style="font-size:var(--text-h3)">Sigue con la explicación.</h2>
      <p class="hint">Si te queda una duda, aquí está de dónde sale la cifra y qué asume.</p>
      <ul class="v2-learn">
        {
          aprender.map((destino) => (
            <li>
              <p class="v2-learn-tipo">
                {destino.tipo}
                {destino.detalle && ` · ${destino.detalle}`}
              </p>
              <h3>
                <a href={url(destino.href)}>{destino.titulo}</a>
              </h3>
              <p>{destino.linea}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </Fragment>
</Herramienta>

<style>
  .legend-inline {
    font-size: 1rem;
    font-weight: 650;
    margin-bottom: 0;
  }
  .radio-row {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .radio-row label {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    min-height: 44px;
    font-weight: 400;
  }
  .radio-row input {
    width: auto;
    min-height: 0;
    margin: 0;
    accent-color: var(--gold);
  }
  .calc-table {
    background: var(--surface);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    margin-top: 2rem;
  }
</style>

<script>
  import {
    calcularInteresCompuesto,
    filasAnuales,
    formatearEuros,
    parsearNumero,
    type ClaveFrecuencia,
    type EntradaCalculo,
    type MomentoAportacion,
  } from '../lib/calculadora.ts';
  import {
    IDS_METRICAS,
    TEXTO_RETIRADO,
    filasVisibles,
    metricasVisibles,
    resumenEntrada,
    textoAnuncio,
    textoError,
  } from '../lib/calculadora-presentacion.ts';
  import { svgEvolucion } from '../lib/calculadora-svg.ts';

  const formulario = document.getElementById('formulario-calculo') as HTMLFormElement | null;
  const cuerpoTabla = document.getElementById('tabla-evolucion-cuerpo');
  const grafico = document.getElementById('grafico');
  const aviso = document.getElementById('aviso-resultado');
  const tituloResultado = document.getElementById('resultado-herramienta');

  const porId = (id: string): HTMLElement | null => document.getElementById(id);
  const valorDe = (id: string): string => (porId(id) as HTMLInputElement | HTMLSelectElement | null)?.value ?? '';

  const leerEntrada = (): EntradaCalculo => {
    const inflacion = valorDe('inflacionAnual').trim();
    return {
      capitalInicial: parsearNumero(valorDe('capitalInicial')),
      aportacionPeriodica: parsearNumero(valorDe('aportacionPeriodica')),
      anios: parsearNumero(valorDe('anios')),
      meses: parsearNumero(valorDe('meses') || '0'),
      rentabilidadAnual: parsearNumero(valorDe('rentabilidadAnual')),
      frecuencia: (valorDe('frecuencia') || 'mensual') as ClaveFrecuencia,
      momentoAportacion: ((formulario?.querySelector('input[name="momentoAportacion"]:checked') as HTMLInputElement | null)
        ?.value ?? 'fin') as MomentoAportacion,
      inflacionAnual: inflacion === '' ? null : parsearNumero(inflacion),
    };
  };

  const CAMPOS = [
    'capitalInicial',
    'aportacionPeriodica',
    'anios',
    'meses',
    'rentabilidadAnual',
    'frecuencia',
    'momentoAportacion',
    'inflacionAnual',
    'plazo',
  ] as const;

  const METRICAS = IDS_METRICAS;

  const limpiarErrores = (): void => {
    for (const campo of CAMPOS) {
      const parrafo = porId(`error-${campo}`);
      if (parrafo) {
        parrafo.textContent = '';
        parrafo.hidden = true;
      }
      porId(campo)?.removeAttribute('aria-invalid');
    }
    for (const id of METRICAS) porId(id)?.removeAttribute('data-invalid');
  };

  const pintarErrores = (errores: { campo: string; mensaje: string }[]): void => {
    limpiarErrores();
    for (const error of errores) {
      const parrafo = porId(`error-${error.campo}`);
      if (parrafo) {
        parrafo.textContent = error.mensaje;
        parrafo.hidden = false;
      }
      const control =
        error.campo === 'plazo' ? porId('anios') : error.campo === 'momentoAportacion' ? porId('momento-fin') : porId(error.campo);
      if (control) control.setAttribute('aria-invalid', 'true');
    }
  };

  const pintarTabla = (filas: ReturnType<typeof filasAnuales>): void => {
    if (!cuerpoTabla) return;
    cuerpoTabla.replaceChildren(
      ...filasVisibles(filas).map((fila) => {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.textContent = String(fila.anio);
        tr.append(th);
        for (const valor of [fila.aportado, fila.interes, fila.capital]) {
          const td = document.createElement('td');
          td.textContent = valor;
          tr.append(td);
        }
        return tr;
      }),
    );
  };

  const escribir = (id: string, texto: string): void => {
    const nodo = porId(id);
    if (nodo) nodo.textContent = texto;
  };

  const mostrarAviso = (texto: string, tono: 'neutro' | 'error'): void => {
    if (!aviso) return;
    aviso.textContent = texto;
    aviso.dataset.tono = tono;
    aviso.hidden = false;
  };

  const ocultarAviso = (): void => {
    if (!aviso) return;
    aviso.textContent = '';
    aviso.hidden = true;
  };

  const retirarResultado = (): void => {
    escribir('capital-final', '—');
    for (const id of METRICAS) escribir(id, '—');
    grafico?.replaceChildren();
    cuerpoTabla?.replaceChildren();
    escribir('resumen-entrada', TEXTO_RETIRADO);
    escribir('estado-calculo', TEXTO_RETIRADO);
  };

  const actualizar = (enfocar: boolean): void => {
    if (!formulario) return;
    const entrada = leerEntrada();
    const respuesta = calcularInteresCompuesto(entrada);
    if (!respuesta.ok) {
      retirarResultado();
      pintarErrores(respuesta.errores);
      mostrarAviso(textoError(respuesta.errores), 'error');
      escribir('estado-calculo', textoError(respuesta.errores));
      const campo = respuesta.errores[0]?.campo;
      const control =
        campo === 'plazo' ? porId('anios') : campo === 'momentoAportacion' ? porId('momento-fin') : porId(campo ?? '');
      control?.focus();
      return;
    }
    limpiarErrores();
    ocultarAviso();
    const r = respuesta.resultado;
    const filas = filasAnuales(r.tabla);

    escribir('capital-final', formatearEuros(r.capitalFinal));
    for (const metrica of metricasVisibles(r)) escribir(metrica.id, metrica.valor);
    escribir('resumen-entrada', resumenEntrada(entrada, r));
    if (grafico) grafico.innerHTML = svgEvolucion(filas);
    pintarTabla(filas);
    escribir('estado-calculo', textoAnuncio(r));
    if (enfocar) tituloResultado?.focus();
  };

  formulario?.addEventListener('submit', (evento) => {
    evento.preventDefault();
    actualizar(true);
  });
  const editar = (): void => {
    limpiarErrores();
    retirarResultado();
    mostrarAviso('Los datos han cambiado: pulsa Calcular para ver el resultado nuevo.', 'neutro');
  };
  formulario?.addEventListener('input', editar);
  formulario?.addEventListener('change', editar);
</script>
