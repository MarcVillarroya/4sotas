---
/** Footer: enlaces reales a rutas existentes. Sin métricas ni datos inventados. */
import { MARCA, SECCION, CANAL_YOUTUBE, url } from '../lib/rutas.ts';
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <div>
      <p class="footer-brand">4 SOTAS</p>
      <p>Las cartas claras. Las decisiones, tuyas.</p>
      <p>{MARCA} es un proyecto editorial independiente sobre economía cotidiana en España.</p>
    </div>
    <div>
      <p>
        <a href={url('/')}>La baraja</a>
        <a href={url('/oros/')}>{SECCION}</a>
        <a href={url('/sobre-4-sotas/')}>Sobre 4 Sotas</a>
        <a href={url('/metodologia/')}>Metodología y fuentes</a>
        <a href={url('/privacidad/')}>Privacidad</a>
        <a href={CANAL_YOUTUBE} target="_blank" rel="noopener">Canal en YouTube <span class="sr-only">(se abre en otra pestaña)</span></a>
      </p>
      <p>Contenido educativo. No es asesoramiento financiero individualizado.</p>
      <p>Sin analítica, sin cuentas ni cookies propias. Algunas miniaturas proceden de YouTube; el reproductor se carga al pedirlo. <a href={url('/privacidad/')}>Información sobre terceros</a>.</p>
    </div>
  </div>
</footer>
