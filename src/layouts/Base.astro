---
/**
 * Head + shell accesible. La canónica se deriva aquí y en ningún otro sitio:
 * exactamente una por página indexable (B-CANONICA).
 */
import '../styles/global.css';
import '../styles/plantillas.css';
import '../styles/v2.css';
import '../styles/v2-1.css';
import '../styles/v3.css';
import { MARCA, url } from '../lib/rutas.ts';
import { ogAbsoluta, tituloDocumento } from '../lib/seo.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
/* URLs hasheadas por Vite: precargar a mano una ruta fija rompe el build. */
import fuenteTexto from '../assets/fonts/inter-latin-400-normal.woff2?url';
import fuenteTextoNegrita from '../assets/fonts/inter-latin-700-normal.woff2?url';
import fuenteTitular from '../assets/fonts/archivo-black-latin-400-normal.woff2?url';

interface Props {
  titulo: string;
  descripcion: string;
  sufijo?: string;
  ogType?: string;
  ogImagen?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  titulo,
  descripcion,
  sufijo = '',
  ogType = 'website',
  ogImagen = '/assets/og/4sotas.png',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const tituloFinal = tituloDocumento(titulo, undefined, sufijo);
const imagenSocial = ogAbsoluta(canonica, url(ogImagen));
---

<!doctype html>
<html lang="es-ES">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1526" />
    <meta name="color-scheme" content="dark" />
    <title>{tituloFinal}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={MARCA} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:alt" content={descripcion} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloFinal} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenSocial} />
    <link rel="icon" href={url('/assets/mark.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    {/* Precarga de las tres caras que se usan sobre el pliegue: sin ella, font-display:swap
        provoca un intercambio tardío y CLS medido de 0,184 en la guía a 768 px. */}
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTextoNegrita} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTitular} as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={`${MARCA} · novedades`} href={url('/rss.xml')} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap-index.xml')} />
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
