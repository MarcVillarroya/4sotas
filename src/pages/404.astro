---
/**
 * 404 útil: qué ha pasado y destinos reales, derivados de las secciones que existen.
 * Se marca noindex (única página legítimamente noindex junto a las puentes de slug antiguo).
 */
import Base from '../layouts/Base.astro';
import { ruta, url } from '../lib/rutas.ts';

const titulo = 'Esta carta no está en la baraja';
const descripcion =
  'La dirección solicitada no existe en 4 Sotas. Desde aquí puedes volver al inicio, entrar en Sota de Oros o seguir por temas, guías, vídeos o glosario.';

/** Destinos reales: cada uno es una página que existe en el build. */
const destinos = [
  {
    titulo: 'Sota de Oros',
    detalle: 'Promesa editorial, estado real de la sección y límites.',
    ruta: '/oros/',
  },
  { titulo: 'Temas troncales', detalle: 'El mapa editorial, con su orden recomendado.', ruta: ruta.temas() },
  { titulo: 'Guías', detalle: 'Explicadores con fuentes fechadas y revisión factual.', ruta: ruta.guias() },
  { titulo: 'Vídeos', detalle: 'Fichas con metadata contrastada contra la API.', ruta: ruta.videos() },
  { titulo: 'Glosario', detalle: 'Términos con definición corta y ejemplo.', ruta: ruta.glosario() },
];
---

<Base titulo={titulo} descripcion={descripcion} noindex={true}>
  <section class="wrap page-intro" aria-labelledby="titulo-404">
    <p class="eyebrow">Error 404</p>
    <h1 id="titulo-404">{titulo}.</h1>
    <p class="lead">
      La dirección que has pedido no existe (o existió y ya no está). No enlazamos a contenido que no hayamos
      publicado, así que aquí no encontrarás un borrador disfrazado.
    </p>
    <div class="actions">
      <a class="button" href={url('/')}>Volver al inicio</a>
      <a class="button secondary" href={url('/oros/')}>Ir a Sota de Oros</a>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="titulo-destinos">
    <h2 id="titulo-destinos">Por dónde seguir.</h2>
    <ul class="link-list">
      {
        destinos.map((d) => (
          <li>
            <a href={url(d.ruta)}>
              {d.titulo} <span aria-hidden="true">↗</span>
            </a>
            <p>{d.detalle}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
