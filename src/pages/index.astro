---
/**
 * Home 4 Sotas. Todo dato visible sale de las colecciones o de decisiones editoriales reales.
 * El friso de palos se genera desde `sotas`; solo el palo activo enlaza.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { MARCA, url } from '../lib/rutas.ts';
import { grafoInicio } from '../lib/jsonld.ts';
import PortadaModulos from '../components/PortadaModulos.astro';
import Sprite from '../components/Sprite.astro';
import { contenidoPortadas } from '../lib/portadas.ts';
const contenido = await contenidoPortadas();

const sotas = await getCollection('sotas');

const ORDEN = ['oros', 'copas', 'espadas', 'bastos'];

const palos = [...sotas].sort((a, b) => ORDEN.indexOf(a.data.palo) - ORDEN.indexOf(b.data.palo));


const titulo = 'La vida no viene con instrucciones';
const descripcion =
  '4 Sotas abre la baraja de la economía cotidiana en España: empezamos por Sota de Oros, con fuentes fechadas y sin promesas de rentabilidad.';
const canonica = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = grafoInicio({
  origen: new URL(canonica).origin,
  url: canonica,
  nombre: `${MARCA} · ${titulo}`,
  descripcion,
});
---

<Base titulo={titulo} descripcion={descripcion} sufijo={MARCA} jsonLd={jsonLd}>
  <section class="wrap hero v21-cover" aria-labelledby="titulo-principal">
    <div>
      <p class="eyebrow">4 Sotas · una baraja para entender el mundo</p>
      <h1 id="titulo-principal">{titulo}.</h1>
      <p class="lead">
        Nómina, IRPF, inflación, ahorro y vivienda, explicados con datos oficiales, fecha de consulta y sin promesas de rentabilidad. Empezamos por Oros.
      </p>
      <div class="actions">
        <a class="button" href={url('/oros/')}>Empezar por Oros</a>
        <a class="text-link" href={url('/oros/videos/')}>Ver los vídeos</a>
      </div>
    </div>
    <figure class="v21-character">
      <div class="v21-card-label"><Sprite familia="emblems" nombre="oros" size={40} inmediato /><span>SOTA DE OROS</span></div>
      <Sprite familia="sota-oros" nombre="sota-bienvenida" personaje inmediato />
      <figcaption>La baraja empieza por Oros.</figcaption>
    </figure>
  </section>

  <section class="wrap section" id="universos" aria-labelledby="titulo-palos">
    <div class="section-head">
      <h2 id="titulo-palos">Una baraja por descubrir.</h2>
      <p class="muted">Oros abre la partida.</p>
    </div>
    <div class="suits">
      {
        palos.map((p) => (
          <article class={p.data.estado === 'activa' ? 'suit active' : 'suit'}>
            <span class="symbol" aria-hidden="true">
              <Sprite familia="emblems" nombre={p.data.palo} size={40} />
            </span>
            <h3>
              {p.data.estado === 'activa' ? <a class="text-link" href={url('/oros/')}>{p.data.nombre}</a> : p.data.nombre}
            </h3>
            <p>{p.data.lema}</p>
            <span class="badge">
              {p.data.estado === 'activa' ? 'En juego' : 'En el mazo'}
            </span>
          </article>
        ))
      }
    </div>
  </section>

  <PortadaModulos {...contenido} />

  <section class="wrap section editorial-grid" id="criterio" aria-labelledby="titulo-criterio">
    <div>
      <p class="eyebrow">Menos ruido. Más contexto.</p>
      <h2 id="titulo-criterio">Sin trucos bajo la manga.</h2>
    </div>
    <div>
      <p>No buscamos darte la última respuesta, sino ayudarte a hacer mejores preguntas.</p>
      <p>Cifras con fuente y fecha. Cálculos con sus supuestos a la vista. Y los límites, antes de sacar conclusiones.</p>
      <p><a class="text-link" href={url('/metodologia/')}>Cómo trabajamos</a></p>
    </div>
  </section>

</Base>
