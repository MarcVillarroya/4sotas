---
/**
 * Índice de temas troncales. Orden editorial (`orden`), no alfabético ni por fecha.
 * Solo se listan entradas visibles: los borradores no generan enlaces.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Sprite from '../../../components/Sprite.astro';
import { MARCA, SECCION, ruta, url } from '../../../lib/rutas.ts';
import { visibles } from '../../../lib/publicacion.ts';
import { absoluta, prepararMigas } from '../../../lib/migas.ts';
import { grafo, lista, paginaWeb, sitioWeb } from '../../../lib/jsonld.ts';
import { iconoDeCluster } from '../../../lib/iconos.ts';

const todos = await getCollection('temas');
const temas = visibles(todos).sort((a, b) => a.data.orden - b.data.orden);

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const origen = new URL(canonica).origin;
const titulo = 'Temas troncales';
const descripcion =
  'Mapa en orden editorial de los temas de Sota de Oros: qué cubre cada bloque, con qué guía empieza y qué vídeos y herramientas lo acompañan cuando estén publicados.';

const { visual, jsonld } = prepararMigas(
  [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: SECCION, ruta: '/oros/' },
    { nombre: titulo, ruta: ruta.temas() },
  ],
  canonica,
);

const jsonLd = grafo([
  sitioWeb(origen),
  paginaWeb({ url: canonica, nombre: `${titulo} · ${SECCION}`, descripcion, tipo: 'CollectionPage' }),
  lista({
    url: canonica,
    nombre: titulo,
    elementos: temas.map((t) => ({ url: absoluta(ruta.tema(t.data.slug), origen), nombre: t.data.titulo })),
  }),
  jsonld,
]);
---

<Base titulo={`${titulo} · ${SECCION}`} descripcion={descripcion} sufijo={MARCA} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs migas={visual} />
  </div>

  <div class="wrap page-intro">
    <p class="eyebrow">{SECCION} · temas</p>
    <h1>Temas troncales.</h1>
    <p class="lead">
      Cada tema es una puerta de entrada: un orden recomendado con la guía que empieza, los vídeos que contextualizan
      y las herramientas que permiten probar escenarios.
    </p>
    <p class="muted">
      El orden no es alfabético: va de lo básico a lo específico. Un tema aparece aquí cuando su página está lista para
      leerse.
    </p>
  </div>

  <div class="wrap section">
    {
      temas.length === 0 ? (
        <div class="empty">
          <h2>Todavía no hay temas publicados.</h2>
          <p>
            Estamos escribiendo las primeras páginas de tema. Cada una sale cuando sus datos están comprobados y sus
            fuentes fechadas.
          </p>
          <p>
            <a class="text-link" href={url(ruta.guias())}>Ver las guías</a>
          </p>
        </div>
      ) : (
        <ol class="catalog">
          {temas.map((tema) => (
            <li>
              <p class="orden">
                Tema {String(tema.data.orden).padStart(2, '0')}
                {iconoDeCluster(tema.data.cluster) && (
                  <Sprite familia="topics" nombre={iconoDeCluster(tema.data.cluster) as string} size={40} />
                )}
              </p>
              <h2>
                <a href={url(ruta.tema(tema.data.slug))}>{tema.data.titulo}</a>
              </h2>
              <p>{tema.data.descripcion_corta}</p>
              <p class="video-meta">
                <span>
                  {tema.data.videos_destacados.length} vídeos · {tema.data.herramientas.length} herramientas
                </span>
              </p>
            </li>
          ))}
        </ol>
      )
    }
  </div>
</Base>
