---
/**
 * Glosario alfabético. Se agrupa por la primera letra del término mostrado (sin artículos),
 * no por el slug: el slug es estable y el término puede cambiar de redacción.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { MARCA, SECCION, ruta, url } from '../../../lib/rutas.ts';
import { visibles } from '../../../lib/publicacion.ts';
import { absoluta, prepararMigas } from '../../../lib/migas.ts';
import { NOMBRE_GLOSARIO, conjuntoTerminos, grafo, sitioWeb } from '../../../lib/jsonld.ts';
import { etiquetaCategoria } from '../../../lib/glosario-presentacion.ts';

const todos = await getCollection('glosario');
const terminos = visibles(todos).sort((a, b) => a.data.termino.localeCompare(b.data.termino, 'es'));

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const origen = new URL(canonica).origin;
const titulo = 'Glosario';
const descripcion =
  'Glosario de Sota de Oros: cada término con definición corta, un ejemplo y los términos con los que se relaciona, sin jerga innecesaria.';

const { visual, jsonld } = prepararMigas(
  [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: SECCION, ruta: '/oros/' },
    { nombre: titulo, ruta: ruta.glosario() },
  ],
  canonica,
);

const letra = (texto: string): string => texto.trim().charAt(0).toLocaleUpperCase('es');
const grupos = terminos.reduce<Record<string, typeof terminos>>((acc, t) => {
  const clave = letra(t.data.termino);
  (acc[clave] ??= []).push(t);
  return acc;
}, {});
const letras = Object.keys(grupos).sort((a, b) => a.localeCompare(b, 'es'));

const jsonLd = grafo([
  sitioWeb(origen),
  conjuntoTerminos({
    url: canonica,
    nombre: NOMBRE_GLOSARIO,
    descripcion,
    terminos: terminos.map((t) => ({ nombre: t.data.termino, url: absoluta(ruta.termino(t.data.slug), origen) })),
  }),
  jsonld,
]);
---

<Base titulo={`${titulo} · ${SECCION}`} descripcion={descripcion} sufijo={MARCA} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs migas={visual} />
  </div>

  <div class="wrap page-intro">
    <p class="eyebrow">{SECCION} · glosario</p>
    <h1>Glosario.</h1>
    <p class="lead">
      Definiciones cortas con un ejemplo y los términos vecinos. Cada ficha enlaza la guía donde el término se usa.
    </p>
  </div>

  <div class="wrap section">
    {
      terminos.length === 0 ? (
        <div class="empty">
          <h2>Todavía no hay términos publicados.</h2>
          <p>
            Los términos están redactados en revisión. No publicamos definiciones sin revisión factual: una definición
            imprecisa es peor que no tener glosario.
          </p>
          <p>
            <a class="text-link" href={url(ruta.guias())}>Ver las guías</a>
          </p>
        </div>
      ) : (
        <>
          <ul class="letter-nav" aria-label="Ir a la letra">
            {letras.map((l) => (
              <li>
                <a href={`#letra-${l}`}>{l}</a>
              </li>
            ))}
          </ul>
          {letras.map((l) => (
            <section id={`letra-${l}`} aria-labelledby={`titulo-letra-${l}`} style="margin-bottom:2.5rem">
              <h2 id={`titulo-letra-${l}`}>{l}</h2>
              <ul class="catalog">
                {(grupos[l] ?? []).map((t) => (
                  <li>
                    <h3>
                      <a href={url(ruta.termino(t.data.slug))}>{t.data.termino}</a>
                    </h3>
                    <p>{t.data.definicion_corta}</p>
                    <p class="video-meta">
                      <span>Categoría: {etiquetaCategoria(t.data.categoria)}</span>
                      {t.data.sinonimos.length > 0 && <span>También: {t.data.sinonimos.join(', ')}</span>}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </>
      )
    }
  </div>
</Base>
