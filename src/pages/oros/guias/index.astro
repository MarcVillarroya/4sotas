---
/**
 * Índice de guías publicadas, orden por fecha de publicación descendente.
 * Sin paginación (V1) y sin enlaces a borradores.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { SECCION, ruta, url } from '../../../lib/rutas.ts';
import { porFechaDesc, resolver, visibles } from '../../../lib/publicacion.ts';
import { absoluta, prepararMigas } from '../../../lib/migas.ts';
import { grafo, lista, paginaWeb, sitioWeb } from '../../../lib/jsonld.ts';
import { fechaLarga } from '../../../lib/format.ts';

const [todos, temas] = await Promise.all([getCollection('articulos'), getCollection('temas')]);
const articulos = visibles(todos).sort(porFechaDesc);
const temasVisibles = visibles(temas);

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const origen = new URL(canonica).origin;
const titulo = 'Guías';
const tituloDocumento = 'Guías de finanzas personales en España';
const descripcion =
  'Guías de Sota de Oros sobre nómina, IRPF, inflación, ahorro y vivienda: qué dicen los datos, con qué fuente y con qué límites.';

/** Tiempo de lectura derivado del Markdown real, no de un campo que pueda quedar desfasado. */
const minutos = (body: string) => Math.max(1, Math.round(body.trim().split(/\s+/).length / 220));

/** Enums sin tilde en el modelo; en pantalla se muestran legibles. */
const ETIQUETA_TIPO: Record<string, string> = { guia: 'Guía', explicador: 'Explicador', analisis: 'Análisis' };
const ETIQUETA_NIVEL: Record<string, string> = { basico: 'Básico', intermedio: 'Intermedio', avanzado: 'Avanzado' };

const { visual, jsonld } = prepararMigas(
  [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: SECCION, ruta: '/oros/' },
    { nombre: titulo, ruta: ruta.guias() },
  ],
  canonica,
);

const jsonLd = grafo([
  sitioWeb(origen),
  paginaWeb({ url: canonica, nombre: `${tituloDocumento} · ${SECCION}`, descripcion, tipo: 'CollectionPage' }),
  lista({
    url: canonica,
    nombre: titulo,
    elementos: articulos.map((a) => ({ url: absoluta(ruta.guia(a.data.slug), origen), nombre: a.data.titulo })),
  }),
  jsonld,
]);
---

<Base titulo={tituloDocumento} descripcion={descripcion} sufijo={SECCION} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs migas={visual} />
  </div>

  <div class="wrap page-intro">
    <p class="eyebrow">{SECCION} · guías</p>
    <h1>Guías.</h1>
    <p class="lead">
      Cada guía responde primero, explica después y separa el dato con fuente del ejemplo y de la hipótesis.
    </p>
    <p class="muted">
      {articulos.length} {articulos.length === 1 ? 'guía publicada' : 'guías publicadas'} · orden por fecha, de la más
      reciente a la más antigua.
    </p>
  </div>

  <div class="wrap section">
    {
      articulos.length === 0 ? (
        <div class="empty">
          <h2>Ninguna guía publicada todavía.</h2>
          <p>
            Estamos escribiendo las primeras. Cada una sale cuando sus datos están comprobados y sus fuentes fechadas:
            preferimos un índice vacío a un enlace que no lleva a nada.
          </p>
          <p>
            <a class="text-link" href={url(ruta.temas())}>Ver los temas</a>
          </p>
        </div>
      ) : (
        <ol class="catalog">
          {articulos.map((art) => {
            const suyos = resolver(art.data.temas, temasVisibles);
            return (
              <li>
                <p class="orden">{ETIQUETA_TIPO[art.data.tipo] ?? art.data.tipo} · {ETIQUETA_NIVEL[art.data.nivel] ?? art.data.nivel}</p>
                <h2>
                  <a href={url(ruta.guia(art.data.slug))}>{art.data.titulo}</a>
                </h2>
                <p>{art.data.resumen}</p>
                <p class="video-meta">
                  <span>Publicada: {fechaLarga(art.data.publicado)}</span>
                  <span>{minutos(art.body ?? '')} min de lectura</span>
                  {suyos.length > 0 && (
                    <span>
                      Temas:{' '}
                      {suyos.map((t, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={url(ruta.tema(t.data.slug))}>{t.data.titulo}</a>
                        </>
                      ))}
                    </span>
                  )}
                </p>
                <p>
                  <a class="text-link" href={url(ruta.guia(art.data.slug))}>
                    Leer la guía<span class="sr-only">: {art.data.titulo}</span> →
                  </a>
                </p>
              </li>
            );
          })}
        </ol>
      )
    }
  </div>
</Base>
