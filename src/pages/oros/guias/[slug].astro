---
/**
 * Guía / artículo. Todo lo que se muestra sale de la entrada y de sus referencias:
 * H1 y título del documento, respuesta corta, cuerpo Markdown, tablas, fuentes tipadas,
 * fechas, autoría, supuestos y límites, relacionados.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Sprite from '../../../components/Sprite.astro';
import TocActivo from '../../../components/TocActivo.astro';
import { MARCA, SECCION, ruta, url } from '../../../lib/rutas.ts';
import { idRef, resolver, visibles } from '../../../lib/publicacion.ts';
import { prepararMigas } from '../../../lib/migas.ts';
import { articulo as articuloJsonLd, grafo, preguntasFrecuentes, sitioWeb } from '../../../lib/jsonld.ts';
import { duracionLegible, fechaISO, fechaLarga } from '../../../lib/format.ts';

interface Props {
  articulo: CollectionEntry<'articulos'>;
}

export async function getStaticPaths() {
  const articulos = visibles(await getCollection('articulos'));
  return articulos.map((articulo) => ({ params: { slug: articulo.data.slug }, props: { articulo } }));
}

const { articulo } = Astro.props;

const [autores, fuentes, videos, glosario, herramientas, temas] = await Promise.all([
  getCollection('autores'),
  getCollection('fuentes'),
  getCollection('videos'),
  getCollection('glosario'),
  getCollection('herramientas'),
  getCollection('temas'),
]);

const redactor = resolver([articulo.data.autorias.redactor], autores)[0];
const revisor = resolver([articulo.data.autorias.revisor], autores)[0];

const fuentesPropias = (articulo.data.fuentes ?? []).flatMap((referencia) => {
  const fuente = resolver([referencia.fuente], fuentes)[0];
  return fuente ? [{ fuente, dato: referencia.dato }] : [];
});

const vids = resolver(articulo.data.videos, visibles(videos));
const terminos = resolver(articulo.data.glosario, visibles(glosario));
const tools = resolver(articulo.data.herramientas, visibles(herramientas));
const temasPropios = resolver(articulo.data.temas, visibles(temas));

/**
 * Vídeos del mismo tema que la guía todavía no declaraba. Da una segunda vía de entrada
 * a fichas que, si no, solo reciben el enlace del listado general.
 */
const idsTemas = new Set(articulo.data.temas.map(idRef));
const videosDelTema = visibles(videos)
  .filter(
    (v) =>
      v.data.estado_youtube === 'publico' &&
      v.data.privacidad_api === 'public' &&
      v.data.temas.some((r) => idsTemas.has(idRef(r))) &&
      !vids.some((d) => d.id === v.id),
  )
  .sort((a, b) => b.data.publicado_en.getTime() - a.data.publicado_en.getTime())
  .slice(0, 3);

const { Content, headings } = await render(articulo);

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const origen = new URL(canonica).origin;

const { visual, jsonld } = prepararMigas(
  [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: SECCION, ruta: '/oros/' },
    { nombre: 'Guías', ruta: ruta.guias() },
    { nombre: articulo.data.titulo, ruta: ruta.guia(articulo.data.slug) },
  ],
  canonica,
);

const actualizado = articulo.data.actualizado ?? articulo.data.publicado;
/** Solo se repite la fecha cuando de verdad cambia algo: tres fechas idénticas parecen plantilla. */
const actualizadoVisible =
  fechaISO(actualizado) !== fechaISO(articulo.data.publicado) ? actualizado : undefined;
const revisadoVisible =
  articulo.data.revisado_factual &&
  fechaISO(articulo.data.revisado_factual) !== fechaISO(actualizado)
    ? articulo.data.revisado_factual
    : undefined;
const esAnalisis = articulo.data.tipo === 'analisis';

/** Etiquetas legibles: los enums no llevan tilde y en pantalla se nota. */
const ETIQUETA_TIPO: Record<string, string> = { guia: 'Guía', explicador: 'Explicador', analisis: 'Análisis' };
const ETIQUETA_NIVEL: Record<string, string> = { basico: 'Básico', intermedio: 'Intermedio', avanzado: 'Avanzado' };

const jsonLd = grafo([
  sitioWeb(origen),
  articuloJsonLd({
    url: canonica,
    titular: articulo.data.titulo,
    descripcion: articulo.data.seo.descripcion ?? articulo.data.resumen,
    publicadoISO: fechaISO(articulo.data.publicado),
    actualizadoISO: fechaISO(actualizado),
    tipo: esAnalisis ? 'BlogPosting' : 'Article',
    autor: { nombre: redactor?.data.nombre_publico ?? MARCA, url: `${origen}/sobre-4-sotas/` },
    seccion: temasPropios[0]?.data.titulo,
    citas: fuentesPropias.map((f) => f.fuente.data.url),
  }),
  jsonld,
  ...(articulo.data.preguntas.length >= 2
    ? [preguntasFrecuentes({ url: canonica, preguntas: articulo.data.preguntas })]
    : []),
]);

const secciones = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hayFuentes = fuentesPropias.length > 0;

/**
 * Módulo «Sigue aprendiendo»: un vídeo, una herramienta y hasta tres términos, como máximo,
 * en tarjetas con etiqueta de tipo. Lo que sobre (una guía puede declarar tres vídeos) se
 * queda como enlaces compactos al final, para no perder navegación ni convertir el pie en
 * un muro de tarjetas.
 */
const videoPrincipal = vids[0];
const videosExtra = vids.slice(1);
const herramientaPrincipal = tools[0];
const terminosVisibles = terminos.slice(0, 3);
const hayRelacionados =
  Boolean(videoPrincipal) || Boolean(herramientaPrincipal) || terminosVisibles.length > 0 ||
  temasPropios.length > 0 || videosDelTema.length > 0;
---

<Base
  titulo={articulo.data.seo.titulo ?? articulo.data.titulo}
  descripcion={articulo.data.seo.descripcion ?? articulo.data.resumen}
  sufijo={SECCION}
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="wrap article-crumbs">
    <Breadcrumbs migas={visual.slice(0, -1)} />
  </div>

  <header class="wrap article-header">
    <p class="eyebrow">{ETIQUETA_TIPO[articulo.data.tipo] ?? articulo.data.tipo} · {ETIQUETA_NIVEL[articulo.data.nivel] ?? articulo.data.nivel} · {SECCION}</p>
    <h1>{articulo.data.titulo}</h1>
    <div class="callout" id="respuesta-corta">
      <strong>Respuesta corta</strong>
      <p>{articulo.data.resumen}</p>
    </div>
    <div class="metadata">
      <span>Publicada: <time datetime={fechaISO(articulo.data.publicado)}>{fechaLarga(articulo.data.publicado)}</time></span>
      {
        actualizadoVisible && (
          <span>
            Actualizada: <time datetime={fechaISO(actualizadoVisible)}>{fechaLarga(actualizadoVisible)}</time>
          </span>
        )
      }
      {
        revisadoVisible && (
          <span>
            Revisión factual: <time datetime={fechaISO(revisadoVisible)}>{fechaLarga(revisadoVisible)}</time>
          </span>
        )
      }
      {redactor && <span>Redacción: {redactor.data.nombre_publico}</span>}
      {articulo.data.autorias.revision_externa && <span>Revisión externa: {articulo.data.autorias.revision_externa}</span>}
    </div>
  </header>

  {
    herramientaPrincipal && (
      <section class="wrap v2-calc-band" aria-labelledby="calcula-tu-caso">
        <div>
          <p class="eyebrow">Herramienta</p>
          <h2 id="calcula-tu-caso">Calcula tu caso.</h2>
          <p>
            Esta guía explica el mecanismo; la calculadora lo aplica a tus cifras, en tu navegador y sin enviar nada.
            Fórmula, supuestos y límites, en la misma página.
          </p>
        </div>
        <a class="button" href={url(ruta.herramienta(herramientaPrincipal.data.slug))}>Calcular mi caso</a>
      </section>
    )
  }

  <div class="wrap article-layout">
    <aside class="route-map" aria-labelledby="indice-guia" data-toc>
      <h2 id="indice-guia">En esta guía</h2>
      {secciones.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      <a href="#supuestos">Supuestos y límites</a>
      {hayFuentes && <a href="#fuentes-citadas">Tabla de fuentes ({fuentesPropias.length})</a>}
      {hayRelacionados && <a href="#relacionados">Sigue aprendiendo</a>}
    </aside>

    <article class="prose" aria-label="Cuerpo de la guía">
      <Content />

      <section id="supuestos">
        <h2>Supuestos y límites.</h2>
        <p>
          Esta guía es educativa: explica cómo funciona un mecanismo y qué dicen sus fuentes, y no recomienda un
          producto ni una decisión individual. Las cifras que aparecen son las de la fuente citada en la fecha de
          consulta; si la norma o el dato cambian, la página se revisa en lugar de quedarse desactualizada.
        </p>
        {
          articulo.data.sensibilidad !== 'baja' && (
            <p class="honest">
              Este tema afecta a decisiones importantes. Antes de aplicarlo a tu caso, revisa tu situación completa.
            </p>
          )
        }
      </section>

      {
        hayFuentes && (
          <section id="fuentes-citadas">
            <h2>Tabla de fuentes.</h2>
            <div class="table-wrap">
              <table class="fuentes">
                <caption>
                  Fuentes consultadas en la fecha indicada. Ninguna afirmación de la guía se apoya en una fuente que no
                  esté aquí.
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Fuente</th>
                    <th scope="col">Editor</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Consultada</th>
                  </tr>
                </thead>
                <tbody>
                  {fuentesPropias.map(({ fuente, dato }) => (
                    <tr>
                      <td>
                        <a href={fuente.data.url} rel="noopener">{fuente.data.titulo}</a>
                        {dato && <p class="muted">{dato}</p>}
                      </td>
                      <td>{fuente.data.editor}</td>
                      <td>{fuente.data.tipo}</td>
                      <td>
                        <time datetime={fechaISO(fuente.data.consultado_en)}>{fechaLarga(fuente.data.consultado_en)}</time>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {
        hayRelacionados && (
          <section id="relacionados" aria-labelledby="sigue-aprendiendo">
            <h2 id="sigue-aprendiendo">Sigue aprendiendo.</h2>
            <p class="muted">
              Tres formas de seguir: si prefieres verlo, probarlo o consultar el término exacto.
            </p>
            <ul class="v2-learn">
              {videoPrincipal && (
                <li>
                  <p class="v2-learn-tipo">
                    <Sprite familia="functional" nombre="video" size={24} /> Vídeo ·{' '}
                    {duracionLegible(videoPrincipal.data.duracion_iso)}
                  </p>
                  <h3>
                    <a href={url(ruta.video(videoPrincipal.data.slug))}>{videoPrincipal.data.titulo}</a>
                  </h3>
                  <p>{videoPrincipal.data.descripcion_corta}</p>
                </li>
              )}
              {herramientaPrincipal && (
                <li>
                  <p class="v2-learn-tipo"><Sprite familia="functional" nombre="calculadora" size={24} /> Herramienta</p>
                  <h3>
                    <a href={url(ruta.herramienta(herramientaPrincipal.data.slug))}>{herramientaPrincipal.data.titulo}</a>
                  </h3>
                  <p>{herramientaPrincipal.data.descripcion}</p>
                </li>
              )}
              {terminosVisibles.map((t) => (
                <li>
                  <p class="v2-learn-tipo">Glosario</p>
                  <h3>
                    <a href={url(ruta.termino(t.data.slug))}>{t.data.termino}</a>
                  </h3>
                  <p>{t.data.definicion_corta}</p>
                </li>
              ))}
            </ul>
            {(temasPropios.length > 0 || videosExtra.length > 0) && (
              <ul class="v2-learn-more">
                {temasPropios.map((t) => (
                  <li>
                    <a href={url(ruta.tema(t.data.slug))}>Tema: {t.data.titulo}</a>
                  </li>
                ))}
                {videosExtra.map((v) => (
                  <li>
                    <a href={url(ruta.video(v.data.slug))}>Vídeo: {v.data.titulo}</a>
                  </li>
                ))}
                {videosDelTema.map((v) => (
                  <li>
                    <a href={url(ruta.video(v.data.slug))}>Vídeo: {v.data.titulo}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }

      {
        articulo.data.preguntas.length >= 2 && (
          <section id="preguntas">
            <h2>Preguntas que responde esta página.</h2>
            {articulo.data.preguntas.map((p) => (
              <details>
                <summary>{p.pregunta}</summary>
                <p>{p.respuesta}</p>
              </details>
            ))}
          </section>
        )
      }

      <section class="article-credits" id="creditos" aria-labelledby="creditos-titulo">
        <h2 id="creditos-titulo">Quién lo escribe y quién lo revisa.</h2>
        <dl>
          {redactor && (
            <div>
              <dt>Redacción</dt>
              <dd>{redactor.data.nombre_publico}</dd>
            </div>
          )}
          {revisor && (
            <div>
              <dt>Revisión factual</dt>
              <dd>
                {revisor.data.nombre_publico}. Comprobación de fuentes, citas y recálculo de las cifras antes de
                publicar.
              </dd>
            </div>
          )}
        </dl>
        <p><a class="text-link" href={url('/metodologia/')}>Cómo verificamos cada cifra</a></p>
      </section>
    </article>
  </div>
  <TocActivo />
</Base>
