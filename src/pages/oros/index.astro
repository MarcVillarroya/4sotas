---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PortadaModulos from '../../components/PortadaModulos.astro';
import { contenidoPortadas } from '../../lib/portadas.ts';
import { MARCA, SECCION, ruta, url } from '../../lib/rutas.ts';
import { grafoSeccion } from '../../lib/jsonld.ts';
const sota = await getEntry('sotas', 'sota-oros');
if (!sota) throw new Error('Falta sota-oros');
const contenido = await contenidoPortadas();
const titulo = 'Tu dinero, con las cartas claras';
const descripcion = 'Sota de Oros explica la economía cotidiana en España: nómina, IRPF, inflación, ahorro y vivienda con fuentes oficiales fechadas.';
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = grafoSeccion({ origen: new URL(canonica).origin, url: canonica, nombre: titulo, descripcion });
const iconos: Record<string, string> = { nomina: 'nomina', fiscal: 'nomina', inflacion: 'inflacion', ahorro: 'ahorro', inversion: 'inversion', banca: 'banca', vivienda: 'vivienda', historia: 'historia' };
---
<Base titulo={`${SECCION} · ${titulo}`} descripcion={descripcion} sufijo={MARCA} jsonLd={jsonLd}>
  <section class="wrap hero oros-hero" aria-labelledby="titulo-principal">
    <div><p class="eyebrow">Sota de Oros · economía cotidiana</p><h1 id="titulo-principal">{titulo}.</h1>
      <p class="lead">{sota.data.promesa}</p>
      <div class="actions"><a class="button" href={url(ruta.videos())}>Ver los vídeos</a>
        {contenido.calculadora && <a class="button secondary" href={url(ruta.herramienta(contenido.calculadora.data.slug))}>Abrir la calculadora</a>}
      </div>
    </div>
    <figure class="hero-art"><img src={url('/assets/v2/sota-explain.svg')} width="160" height="224" alt="" />
      <figcaption class="art-note">Primero, entender. Después, decidir.</figcaption></figure>
  </section>
  <section class="wrap section" aria-labelledby="temas-titulo">
    <div class="section-head"><h2 id="temas-titulo">Entra por tu pregunta.</h2><a class="text-link" href={url(ruta.temas())}>Todos los temas</a></div>
    <p class="muted">Cada tema reúne sus guías y vídeos para ayudarte a entender el dinero de cada día.</p>
    <ul class="v2-topics">{contenido.mapa.map(({tema, guias, videos}) => <li>
      <a href={url(ruta.tema(tema.data.slug))}><img src={url(`/assets/v2/topic-${iconos[tema.data.cluster] ?? 'empezar'}.svg`)} width="40" height="40" alt="" loading="lazy" />
        <h3>{tema.data.titulo}</h3><p>{tema.data.descripcion_corta}</p>
        <span class="muted">{guias === 0 ? 'Sin guía todavía' : `${guias} ${guias === 1 ? 'guía' : 'guías'}`} · {videos} {videos === 1 ? 'vídeo' : 'vídeos'}</span>
      </a></li>)}</ul>
  </section>
  <PortadaModulos {...contenido} portal />
  {contenido.glosario.length > 0 && <section class="wrap section" aria-labelledby="glosario-titulo">
    <div class="section-head"><h2 id="glosario-titulo">Las palabras, claras.</h2><a class="text-link" href={url(ruta.glosario())}>Ver el glosario completo</a></div>
    <p class="muted">Términos que aparecen en las guías para empezar.</p>
    <dl class="v2-terms">{contenido.glosario.map(g => <div><dt><a href={url(ruta.termino(g.data.slug))}>{g.data.termino}</a></dt><dd>{g.data.definicion_corta}</dd></div>)}</dl>
  </section>}
  <section class="wrap section editorial-grid" aria-labelledby="limites-titulo"><h2 id="limites-titulo">Antes de sacar conclusiones.</h2>
    <div><p>El contenido educativo no sustituye el asesoramiento individualizado. Un cálculo depende de sus supuestos y no garantiza lo que ocurrirá: separamos el dato con fuente del ejemplo y de la hipótesis.</p>
      <p><a class="text-link" href={url('/metodologia/')}>Metodología y fuentes</a></p></div>
  </section>
</Base>