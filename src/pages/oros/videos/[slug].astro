---
/**
 * Watch page: reproductor con facade (sin iframe hasta la interacción), resumen editorial
 * propio, metadata real de la ficha verificada y relacionados. VideoObject derivado.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FacadeVideo from '../../../components/FacadeVideo.astro';
import { MARCA, SECCION, embedYouTube, ruta, url, verEnYouTube } from '../../../lib/rutas.ts';
import { resolver, visibles } from '../../../lib/publicacion.ts';
import { prepararMigas } from '../../../lib/migas.ts';
import { grafo, sitioWeb, videoObjeto } from '../../../lib/jsonld.ts';
import { duracionLegible, fechaISO, fechaLarga, marcaTiempo } from '../../../lib/format.ts';

interface Props {
  video: CollectionEntry<'videos'>;
}

export async function getStaticPaths() {
  const videos = visibles(await getCollection('videos')).filter(
    (v) => v.data.estado_youtube === 'publico' && v.data.privacidad_api === 'public',
  );
  return videos.map((video) => ({ params: { slug: video.data.slug }, props: { video } }));
}

const { video } = Astro.props;

const [videos, temas] = await Promise.all([getCollection('videos'), getCollection('temas')]);

const relacionados = resolver(video.data.relacionados, visibles(videos)).filter(
  (v) => v.id !== video.id && v.data.estado_youtube === 'publico',
);
const temasPropios = resolver(video.data.temas, visibles(temas));

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const origen = new URL(canonica).origin;
const duracion = duracionLegible(video.data.duracion_iso);

const { visual, jsonld } = prepararMigas(
  [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: SECCION, ruta: '/oros/' },
    { nombre: 'Vídeos', ruta: ruta.videos() },
    { nombre: video.data.titulo, ruta: ruta.video(video.data.slug) },
  ],
  canonica,
);

const jsonLd = grafo([
  sitioWeb(origen),
  videoObjeto({
    url: canonica,
    nombre: video.data.titulo,
    descripcion: video.data.seo.descripcion ?? video.data.descripcion_corta,
    miniaturas: [video.data.miniatura],
    subidoISO: fechaISO(video.data.publicado_en),
    duracionISO: video.data.duracion_iso,
    embedUrl: embedYouTube(video.data.youtube_id),
  }),
  jsonld,
]);
---

<Base
  titulo={`${video.data.titulo} · ${SECCION}`}
  descripcion={video.data.seo.descripcion ?? video.data.descripcion_corta}
  sufijo={MARCA}
  ogType="video.other"
  ogImagen={video.data.miniatura_local}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <Breadcrumbs migas={visual} />
  </div>

  <div class="wrap watch-layout">
    <div>
      <FacadeVideo youtubeId={video.data.youtube_id} titulo={video.data.titulo} duracion={duracion} />

      <header class="watch-info">
        <p class="eyebrow">
          {temasPropios.length > 0 ? temasPropios.map((t) => t.data.titulo).join(' · ') : SECCION} · vídeo publicado
        </p>
        <h1>{video.data.titulo}</h1>
        <p class="lead">{video.data.descripcion_corta}</p>
        <div class="metadata">
          <span>
            Publicado: <time datetime={fechaISO(video.data.publicado_en)}>{fechaLarga(video.data.publicado_en)}</time>
          </span>
          <span>Duración: {duracion}</span>
          <span>
            Ficha contrastada con la API: <time datetime={fechaISO(video.data.verificado_en)}>
              {fechaLarga(video.data.verificado_en)}
            </time>
          </span>
          <span>Estado en YouTube: {video.data.estado_youtube}</span>
        </div>
      </header>
    </div>

    <aside class="chapters" aria-labelledby="acompanar">
      <h2 id="acompanar">Para acompañar el vídeo</h2>
      <p>Enlaces de esta ficha, no capítulos del vídeo ni marcas de tiempo inventadas.</p>
      <a href="#contexto">Contexto</a>
      {video.data.capitulos.length > 0 && <a href="#capitulos">Capítulos</a>}
      <a href="#ficha">Cómo se verificó la ficha</a>
      {temasPropios.length > 0 && <a href="#seguir">Seguir aprendiendo</a>}
      <a href={verEnYouTube(video.data.youtube_id)} rel="noopener">Abrir en YouTube</a>
    </aside>
  </div>

  <div class="wrap transcript">
    <section id="contexto">
      <h2>De qué trata.</h2>
      <p>{video.data.descripcion_corta}</p>
      <p>
        Esta ficha no reproduce la descripción de YouTube: el resumen de arriba es editorial y el título, la duración y
        la fecha vienen de la API, no del archivo de montaje.
      </p>
      {
        video.data.transcripcion ? (
          <p>La transcripción revisada se publica en esta misma página.</p>
        ) : (
          <p class="honest">
            Este vídeo no tiene transcripción publicada. No inventamos una: el resumen de arriba describe el tema, no
            cada minuto del vídeo.
          </p>
        )
      }
    </section>

    {
      video.data.capitulos.length > 0 && (
        <section id="capitulos">
          <h2>Capítulos.</h2>
          <ol class="link-list">
            {video.data.capitulos.map((c) => (
              <li>
                <span class="orden">{marcaTiempo(c.segundo)}</span> {c.titulo}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section id="ficha">
      <h2>Cómo se verificó la ficha.</h2>
      <p>
        El título, la fecha de publicación y la duración se contrastaron contra la API de YouTube el{' '}
        {fechaLarga(video.data.verificado_en)}. Si el vídeo deja de ser público, esta página deja de generarse en el
        siguiente build en lugar de quedarse publicada sin contenido real.
      </p>
      <p>
        <a class="text-link" href={url(ruta.videos())}>Volver al catálogo de vídeos</a>
      </p>
    </section>

    {
      (temasPropios.length > 0 || relacionados.length > 0) && (
        <section id="seguir">
          <h2>Seguir aprendiendo.</h2>
          <ul class="link-list">
            {temasPropios.map((t) => (
              <li>
                <a href={url(ruta.tema(t.data.slug))}>Tema: {t.data.titulo}</a>
                <p>{t.data.descripcion_corta}</p>
              </li>
            ))}
            {relacionados.map((v) => (
              <li>
                <a href={url(ruta.video(v.data.slug))}>{v.data.titulo}</a>
                <p>{v.data.descripcion_corta}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
