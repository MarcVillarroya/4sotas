---
/**
 * Ficha de vídeo: escenario 16:9 con fachada, dos acciones igual de visibles
 * («Reproducir aquí» y «Ver en YouTube») y una continuación real: la guía que cita el vídeo,
 * la calculadora de su tema y las piezas relacionadas del propio catálogo.
 *
 * Sin jerga de proceso en la vista: la línea editorial indica la última revisión y la fuente.
 * VideoObject declara miniatura absoluta, fechas y embedUrl de YouTube.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FacadeVideo from '../../../components/FacadeVideo.astro';
import Sprite from '../../../components/Sprite.astro';
import { MARCA, SECCION, embedYouTube, ruta, url } from '../../../lib/rutas.ts';
import { idRef, resolver, visibles } from '../../../lib/publicacion.ts';
import { prepararMigas } from '../../../lib/migas.ts';
import { grafo, sitioWeb, videoObjeto } from '../../../lib/jsonld.ts';
import { duracionLegible, fechaISO, fechaLarga, marcaTiempo } from '../../../lib/format.ts';
import { SIZES_PORTADA, duracionReloj, formatoLegible, srcsetMiniatura } from '../../../lib/videos.ts';
import { iconoDeCluster } from '../../../lib/iconos.ts';

interface Props {
  video: CollectionEntry<'videos'>;
}

export async function getStaticPaths() {
  const publicables = visibles(await getCollection('videos')).filter(
    (v) => v.data.estado_youtube === 'publico' && v.data.privacidad_api === 'public',
  );
  return publicables.map((video) => ({ params: { slug: video.data.slug }, props: { video } }));
}

const { video } = Astro.props;

const [videos, temas, articulos, herramientas] = await Promise.all([
  getCollection('videos'),
  getCollection('temas'),
  getCollection('articulos'),
  getCollection('herramientas'),
]);

const relacionados = resolver(video.data.relacionados, visibles(videos)).filter(
  (v) => v.id !== video.id && v.data.estado_youtube === 'publico',
);
const temasPropios = resolver(video.data.temas, visibles(temas));
const idsTemas = new Set(temasPropios.map((t) => t.id));

/** Guías publicadas que citan este vídeo: la relación está en el contenido, no en una etiqueta. */
const guias = visibles(articulos)
  .filter((a) => a.data.videos.map(idRef).includes(video.id))
  .sort((a, b) => (b.data.publicado?.getTime() ?? 0) - (a.data.publicado?.getTime() ?? 0))
  .slice(0, 2);

/** Calculadora publicada que comparte tema con el vídeo. */
const herramienta = visibles(herramientas).find(
  (h) =>
    h.data.estado_implementacion !== 'no-implementada' && h.data.temas.map(idRef).some((t) => t && idsTemas.has(t)),
);

const continuaciones = [
  ...guias.map((g) => ({
    tipo: 'Guía',
    titulo: g.data.titulo,
    descripcion: g.data.resumen,
    href: url(ruta.guia(g.data.slug)),
  })),
  ...(herramienta
    ? [
        {
          tipo: 'Calculadora',
          titulo: herramienta.data.titulo,
          descripcion: herramienta.data.descripcion,
          href: url(ruta.herramienta(herramienta.data.slug)),
        },
      ]
    : []),
  ...relacionados.map((v) => ({
    tipo: 'Vídeo',
    titulo: v.data.titulo,
    descripcion: v.data.descripcion_corta,
    href: url(ruta.video(v.data.slug)),
  })),
];

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const origen = new URL(canonica).origin;
const duracion = duracionLegible(video.data.duracion_iso);
const reloj = duracionReloj(video.data.duracion_iso);
const etiquetaFormato = formatoLegible(video.data.duracion_iso);
const miniLocal = video.data.miniatura_local ?? `/assets/videos/${video.data.youtube_id}.webp`;
const insertable = video.data.insercion !== 'deshabilitada';

/** Información editorial de la ficha (V2.2-A): completa o declarada pendiente, nunca inventada. */
const info = video.data.informacion;
const infoCompleta = info.estado === 'completo';

/** Objeto temático del primer tema del vídeo: ilustra de qué va sin repetir el personaje en 11 fichas. */
const iconoTema = temasPropios[0] ? iconoDeCluster(temasPropios[0].data.cluster) : null;

/** Texto del enlace de continuación: dice qué encontrará, no «ver más». */
const ETIQUETA_CONTINUACION: Record<string, string> = {
  Guía: 'Leer la guía completa',
  Calculadora: 'Abrir la calculadora',
  Vídeo: 'Ver la ficha del vídeo relacionado',
};

const { visual, jsonld } = prepararMigas(
  [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: SECCION, ruta: '/oros/' },
    { nombre: 'Vídeos', ruta: ruta.videos() },
    { nombre: video.data.titulo, ruta: ruta.video(video.data.slug) },
  ],
  canonica,
);

const jsonLd = grafo([
  sitioWeb(origen),
  videoObjeto({
    url: canonica,
    nombre: video.data.titulo,
    descripcion: video.data.seo.descripcion ?? video.data.descripcion_corta,
    miniaturas: [new URL(url(miniLocal), canonica).href, video.data.miniatura],
    subidoISO: fechaISO(video.data.publicado_en),
    duracionISO: video.data.duracion_iso,
    embedUrl: embedYouTube(video.data.youtube_id),
    revisadoISO: video.data.revisado_factual ? fechaISO(video.data.revisado_factual) : undefined,
  }),
  jsonld,
]);
---

<Base
  titulo={`${video.data.titulo} · ${SECCION}`}
  descripcion={video.data.seo.descripcion ?? video.data.descripcion_corta}
  sufijo={MARCA}
  ogType="video.other"
  ogImagen={miniLocal}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <Breadcrumbs migas={visual} />
  </div>

  <div class="wrap v2-watch">
    <header class="v2-watch-head">
      <p class="eyebrow">
        {etiquetaFormato} · {reloj} · {temasPropios.length > 0 ? temasPropios.map((t) => t.data.titulo).join(' · ') : SECCION}
      </p>
      <h1>{video.data.titulo}</h1>
      <p class="v2-meta">
        {SECCION} en YouTube · Publicado el{' '}
        <time datetime={fechaISO(video.data.publicado_en)}>{fechaLarga(video.data.publicado_en)}</time> · {duracion}
      </p>
    </header>

    <div class="v2-watch-layout">
      <div>
        <FacadeVideo
          youtubeId={video.data.youtube_id}
          titulo={video.data.titulo}
          duracion={reloj}
          formato={etiquetaFormato}
          miniatura={url(miniLocal)}
          miniaturaSrcset={srcsetMiniatura(url(miniLocal))}
          sizes={SIZES_PORTADA}
          insertable={insertable}
        />
      </div>

      <aside class="v2-watch-aside" aria-labelledby="continuar-titulo">
        <p class="eyebrow">Sigue con esto</p>
        <h2 id="continuar-titulo">
          {continuaciones[0] ? continuaciones[0].titulo : 'De qué va el vídeo'}
        </h2>
        <p class="v2-meta">
          {continuaciones[0] ? continuaciones[0].descripcion : video.data.descripcion_corta}
        </p>
        {
          continuaciones[0] && (
            <a class="text-link" href={continuaciones[0].href}>
              {ETIQUETA_CONTINUACION[continuaciones[0].tipo] ?? 'Seguir por aquí'}
            </a>
          )
        }
        {iconoTema && <Sprite familia="topics" nombre={iconoTema} size={40} />}
      </aside>
    </div>
  </div>

  <div class="wrap v2-transcript">
    <section id="contexto" aria-labelledby="contexto-titulo">
      <h2 id="contexto-titulo">De qué trata.</h2>
      <p>{infoCompleta && info.resumen ? info.resumen : video.data.descripcion_corta}</p>
      {
        infoCompleta && info.que_cubre.length > 0 && (
          <div class="stack">
            <h3>Qué cubre este vídeo</h3>
            <ul class="v2-meta">
              {info.que_cubre.map((punto) => (
                <li>{punto}</li>
              ))}
            </ul>
            {info.que_no_cubre.length > 0 && (
              <p class="v2-meta">
                <strong>Qué no cubre.</strong> {info.que_no_cubre.join(' ')}
              </p>
            )}
            {info.para_quien && <p class="v2-meta">Para quién: {info.para_quien}</p>}
          </div>
        )
      }
      <p class="v2-meta">
        Este resumen cuenta de qué va el vídeo, no lo que dice cada minuto. El título, la duración y la fecha son los
        del vídeo publicado en el canal.
      </p>
      {
        !infoCompleta && (
          <p class="honest">
            Esta ficha aún no tiene resumen editorial verificado: falta{' '}
            {info.faltan.length > 0 ? info.faltan.join(', ') : 'la información editorial'}. Preferimos decirlo a inventarlo.
          </p>
        )
      }
      {
        video.data.transcripcion ? (
          <p>La transcripción revisada está más abajo, en esta misma página.</p>
        ) : (
          <p class="honest">
            Este vídeo no tiene transcripción. El resumen de arriba cuenta el tema, no cada minuto.
          </p>
        )
      }
    </section>

    {
      video.data.capitulos.length > 0 && (
        <section id="capitulos">
          <h2>Capítulos.</h2>
          <ol class="link-list">
            {video.data.capitulos.map((c) => (
              <li>
                <span class="orden">{marcaTiempo(c.segundo)}</span> {c.titulo}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      continuaciones.length > 0 && (
        <section id="seguir" aria-labelledby="seguir-titulo">
          <h2 id="seguir-titulo">Sigue aprendiendo.</h2>
          <p class="v2-meta">
            Guías que citan este vídeo, la calculadora de su tema y otros vídeos que lo acompañan.
          </p>
          <ul class="v2-learn">
            {continuaciones.map((c) => (
              <li>
                <p class="v2-learn-tipo">
                  <Sprite
                    familia="functional"
                    nombre={c.tipo === 'Guía' ? 'guia' : c.tipo === 'Calculadora' ? 'calculadora' : 'video'}
                    size={24}
                  />
                  {c.tipo}
                </p>
                <h3>
                  <a href={c.href}>{c.titulo}</a>
                </h3>
                <p>{c.descripcion}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="ficha" aria-labelledby="ficha-titulo">
      <h2 id="ficha-titulo">Sobre esta ficha.</h2>
      <p>
        Revisado por última vez el{' '}
        <time datetime={fechaISO(video.data.revisado_factual ?? video.data.verificado_en)}>
          {fechaLarga(video.data.revisado_factual ?? video.data.verificado_en)}
        </time>. Los datos del vídeo vienen del canal de {SECCION} en YouTube; el resumen y las relaciones con guías y
        calculadoras son nuestros.
      </p>
      <p>
        Si un vídeo deja de estar disponible, su ficha desaparece de aquí.
      </p>
      <p>
        <a class="text-link" href={url(ruta.videos())}>Volver a todos los vídeos</a>
      </p>
    </section>
  </div>
</Base>
