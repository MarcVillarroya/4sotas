---
/**
 * Catálogo de vídeos: una tarjeta por ficha verificada, con miniatura ligera y sin iframes.
 * Ningún reproductor se inserta en el listado; el iframe solo existe tras la interacción
 * en la watch page.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { MARCA, SECCION, ruta, url } from '../../../lib/rutas.ts';
import { porFechaDesc, visibles } from '../../../lib/publicacion.ts';
import { absoluta, prepararMigas } from '../../../lib/migas.ts';
import { grafo, lista, paginaWeb, sitioWeb } from '../../../lib/jsonld.ts';
import { duracionLegible, fechaLarga } from '../../../lib/format.ts';

const todos = await getCollection('videos');
/** Un vídeo solo entra si su ficha está publicada y su estado real en YouTube es público. */
const videos = visibles(todos)
  .filter((v) => v.data.estado_youtube === 'publico' && v.data.privacidad_api === 'public')
  .sort(porFechaDesc);

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const origen = new URL(canonica).origin;
const titulo = 'Vídeos';
const descripcion =
  'Catálogo de vídeos de Sota de Oros con ficha propia: título, duración y fecha contrastados contra la API de YouTube, resumen editorial y contexto de lectura.';

const { visual, jsonld } = prepararMigas(
  [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: SECCION, ruta: '/oros/' },
    { nombre: titulo, ruta: ruta.videos() },
  ],
  canonica,
);

const jsonLd = grafo([
  sitioWeb(origen),
  paginaWeb({ url: canonica, nombre: `${titulo} · ${SECCION}`, descripcion, tipo: 'CollectionPage' }),
  lista({
    url: canonica,
    nombre: titulo,
    elementos: videos.map((v) => ({ url: absoluta(ruta.video(v.data.slug), origen), nombre: v.data.titulo })),
  }),
  jsonld,
]);
---

<Base titulo={`${titulo} · ${SECCION}`} descripcion={descripcion} sufijo={MARCA} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs migas={visual} />
  </div>

  <div class="wrap page-intro">
    <p class="eyebrow">{SECCION} · catálogo</p>
    <h1>Vídeos.</h1>
    <p class="lead">
      Cada vídeo tiene su ficha: metadata contrastada con la API, un resumen escrito aquí y el contexto que el vídeo
      solo no da.
    </p>
    <p class="muted">
      El listado no inserta reproductores. Las miniaturas se cargan de forma diferida y el vídeo se abre en su ficha.
    </p>
  </div>

  <div class="wrap section">
    {
      videos.length === 0 ? (
        <div class="empty">
          <h2>Ninguna ficha de vídeo publicada.</h2>
          <p>
            Una ficha solo se publica cuando su estado real en YouTube es público, la metadata está contrastada con la
            API y el resumen es propio. Hoy no hay ninguna que cumpla las tres cosas.
          </p>
          <p>
            <a class="text-link" href={url(ruta.temas())}>Ver los temas troncales</a>
          </p>
        </div>
      ) : (
        <ul class="video-grid">
          {videos.map((video) => (
            <li class="video-card">
              <a href={url(ruta.video(video.data.slug))}>
                <img
                  class="video-thumb"
                  src={video.data.miniatura_local ? url(video.data.miniatura_local) : video.data.miniatura}
                  alt=""
                  width="320"
                  height="180"
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                />
                <div class="video-card-body">
                  <h2>{video.data.titulo}</h2>
                  <p>{video.data.descripcion_corta}</p>
                  <p class="video-meta">
                    <span>{duracionLegible(video.data.duracion_iso)}</span>
                    <span>{fechaLarga(video.data.publicado_en)}</span>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
