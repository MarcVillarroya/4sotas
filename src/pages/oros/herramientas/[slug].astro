---
/**
 * Página de una herramienta generada desde la colección.
 *
 * Una sola ruta, dos formas:
 *  - las calculadoras registradas en `CALCULADORAS` renderizan su interfaz interactiva;
 *  - el resto renderiza la metodología sin formulario mientras su motor no exista.
 *
 * Si una ficha declara `estado_implementacion` distinta de `no-implementada` y no tiene
 * componente registrado, el build falla: no se publica una herramienta que no calcula.
 *
 * La ruta se genera con `visibles()`, así que la página aparece exactamente cuando la ficha
 * es visible en el build actual: un borrador nunca tiene página pública.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Herramienta from '../../../layouts/Herramienta.astro';
import CalculadoraInteresCompuesto from '../../../components/CalculadoraInteresCompuesto.astro';
import CalculadoraPrestamo from '../../../components/CalculadoraPrestamo.astro';
import CalculadoraHipoteca from '../../../components/CalculadoraHipoteca.astro';
import CalculadoraViabilidadHipoteca from '../../../components/CalculadoraViabilidadHipoteca.astro';
import { visibles } from '../../../lib/publicacion.ts';

interface Props {
  ficha: CollectionEntry<'herramientas'>;
}

/** Registro explícito: slug de la ficha → componente que la calcula. */
const CALCULADORAS: Record<string, typeof CalculadoraInteresCompuesto> = {
  'interes-compuesto': CalculadoraInteresCompuesto,
  prestamo: CalculadoraPrestamo,
  hipoteca: CalculadoraHipoteca,
  'viabilidad-hipoteca': CalculadoraViabilidadHipoteca,
};

export async function getStaticPaths() {
  const herramientas = visibles(await getCollection('herramientas'));
  return herramientas.map((ficha) => ({ params: { slug: ficha.data.slug }, props: { ficha } }));
}

const { ficha } = Astro.props;
const calcula = ficha.data.estado_implementacion !== 'no-implementada';
const Calculadora = CALCULADORAS[ficha.data.slug];

if (calcula && !Calculadora) {
  throw new Error(
    `La herramienta "${ficha.data.slug}" declara estado_implementacion="${ficha.data.estado_implementacion}" ` +
      'pero no tiene componente registrado en CALCULADORAS (src/pages/oros/herramientas/[slug].astro).',
  );
}
---

{
  Calculadora ? (
    <Calculadora ficha={ficha} />
  ) : (
    <Herramienta ficha={ficha} calcula={calcula}>
      <p>
        Todavía no hay formulario porque todavía no hay cálculo. Aquí está la metodología que seguirá cuando lo haya.
      </p>
      <p class="hint">
        Nada de lo que escribas aquí se envía a ningún sitio: esta página no usa analítica ni carga nada de terceros.
      </p>
    </Herramienta>
  )
}
