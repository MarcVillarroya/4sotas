---
/**
 * Página de una herramienta generada desde la colección.
 *
 * Dos formas, una sola ruta:
 *  - `interes-compuesto` renderiza la interfaz interactiva desde `CalculadoraInteresCompuesto`
 *    (motor probado en `src/lib/calculadora.ts`, vectores en `docs/CALCULADORA.md`).
 *  - el resto renderiza la metodología sin interfaz mientras su motor no exista.
 *
 * La ruta se genera con `visibles()`, así que la página aparece exactamente cuando la ficha
 * es visible en el build actual: un borrador nunca tiene página pública.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Herramienta from '../../../layouts/Herramienta.astro';
import CalculadoraInteresCompuesto from '../../../components/CalculadoraInteresCompuesto.astro';
import { visibles } from '../../../lib/publicacion.ts';

interface Props {
  ficha: CollectionEntry<'herramientas'>;
}

export async function getStaticPaths() {
  const herramientas = visibles(await getCollection('herramientas'));
  return herramientas.map((ficha) => ({ params: { slug: ficha.data.slug }, props: { ficha } }));
}

const { ficha } = Astro.props;
const calcula = ficha.data.estado_implementacion !== 'no-implementada';
const esCalculadora = ficha.data.slug === 'interes-compuesto';
---

{
  esCalculadora ? (
    <CalculadoraInteresCompuesto ficha={ficha} />
  ) : (
    <Herramienta ficha={ficha} calcula={calcula}>
      <p class="eyebrow">Interfaz</p>
      {calcula ? (
        <p>
          Esta herramienta está marcada como <strong>{ficha.data.estado_implementacion}</strong> en la ficha, pero su
          interfaz interactiva se publica en su propia página. Desde aquí puedes revisar la metodología completa antes de
          usarla.
        </p>
      ) : (
        <p>
          Esta herramienta está en preparación: no hay formulario porque no hay motor que responder. Lo que sí está
          publicado es la metodología que el motor tendrá que cumplir.
        </p>
      )}
      <p class="hint">
        Nada de lo que escribas aquí se envía a un servidor. La página no incluye analítica ni peticiones de terceros.
      </p>
    </Herramienta>
  )
}
