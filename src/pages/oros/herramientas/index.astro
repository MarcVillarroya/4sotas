---
/**
 * Índice de herramientas. Agrupa por intención (vivienda, deudas, ahorro) para que cada
 * calculadora se encuentre por la pregunta que responde, no por su nombre interno.
 * Si una herramienta no está implementada no se enlaza; si no hay ninguna, se dice.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Sprite from '../../../components/Sprite.astro';
import { MARCA, SECCION, ruta, url } from '../../../lib/rutas.ts';
import { visibles } from '../../../lib/publicacion.ts';
import { absoluta, prepararMigas } from '../../../lib/migas.ts';
import { aplicacionSoftware, grafo, lista, paginaWeb, sitioWeb } from '../../../lib/jsonld.ts';

const todas = await getCollection('herramientas');
const herramientas = visibles(todas).sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'es'));

/** Estado legible. `no-implementada` nunca se publica (lo bloquea el validador), pero se declara. */
const ETIQUETA_ESTADO: Record<string, string> = {
  'no-implementada': 'Todavía no calcula',
  beta: 'Calcula aquí',
  estable: 'Disponible',
};

/** Agrupación por intención: primero la pregunta, después la herramienta. */
const GRUPOS = [
  {
    clave: 'vivienda',
    titulo: 'Vivienda',
    descripcion: 'Cuánto pagarás al mes y si la compra encaja con tu ahorro y tus ingresos.',
    slugs: ['hipoteca', 'viabilidad-hipoteca', 'amortizacion-anticipada'],
  },
  {
    clave: 'deudas',
    titulo: 'Deudas',
    descripcion: 'Cuánto cuesta de verdad un préstamo: cuota, intereses y TAE.',
    slugs: ['prestamo'],
  },
  {
    clave: 'ahorro',
    titulo: 'Ahorro',
    descripcion: 'Cuánto puede crecer lo que apartas, con la hipótesis de rentabilidad que elijas.',
    slugs: ['interes-compuesto'],
  },
] as const;

const usadas = new Set<string>(GRUPOS.flatMap((g) => g.slugs));
const grupos = GRUPOS.map((grupo) => ({
  ...grupo,
  herramientas: grupo.slugs
    .map((slug) => herramientas.find((h) => h.data.slug === slug))
    .filter((h): h is (typeof herramientas)[number] => Boolean(h)),
}));
const sueltas = herramientas.filter((h) => !usadas.has(h.data.slug));

const canonica = new URL(Astro.url.pathname, Astro.site).href;
const origen = new URL(canonica).origin;
const titulo = 'Herramientas';
const descripcion =
  'Herramientas de Sota de Oros: calculadoras locales con fórmula, supuestos y límites publicados. Sin envío de datos y sin promesas de rentabilidad.';

const { visual, jsonld } = prepararMigas(
  [
    { nombre: 'Inicio', ruta: '/' },
    { nombre: SECCION, ruta: '/oros/' },
    { nombre: titulo, ruta: ruta.herramientas() },
  ],
  canonica,
);

const jsonLd = grafo([
  sitioWeb(origen),
  paginaWeb({ url: canonica, nombre: `${titulo} · ${SECCION}`, descripcion, tipo: 'CollectionPage' }),
  lista({
    url: canonica,
    nombre: titulo,
    elementos: herramientas.map((h) => ({ url: absoluta(ruta.herramienta(h.data.slug), origen), nombre: h.data.titulo })),
  }),
  ...herramientas
    .filter((h) => h.data.estado_implementacion !== 'no-implementada')
    .map((h) =>
      aplicacionSoftware({
        url: absoluta(ruta.herramienta(h.data.slug), origen),
        nombre: h.data.titulo,
        descripcion: h.data.descripcion,
        version: h.data.version_motor,
      }),
    ),
  jsonld,
]);
---

<Base titulo={titulo} descripcion={descripcion} sufijo={SECCION} jsonLd={jsonLd}>
  <div class="wrap">
    <Breadcrumbs migas={visual} />
  </div>

  <div class="wrap page-intro">
    <p class="eyebrow">{SECCION} · herramientas</p>
    <h1>Herramientas.</h1>
    <p class="lead">
      Calculadoras que se ejecutan en tu navegador. Cada una publica su fórmula, sus supuestos y sus límites antes de
      dar un número.
    </p>
    <p class="muted">Ninguna herramienta envía tus datos a ningún sitio: el cálculo ocurre en tu navegador.</p>
  </div>

  <div class="wrap section">
    {
      herramientas.length === 0 ? (
        <div class="empty">
          <h2>Todavía no hay ninguna herramienta disponible.</h2>
          <p>
            Preferimos no anunciar una calculadora hasta que calcule y podamos enseñar sus cuentas. Mientras tanto, las
            guías tienen las cuentas hechas paso a paso.
          </p>
          <p>
            <a class="text-link" href={url(ruta.guias())}>Leer las guías mientras tanto</a>
          </p>
        </div>
      ) : (
        <>
          {grupos
            .filter((grupo) => grupo.herramientas.length > 0)
            .map((grupo) => (
              <section class="v2-tools-group" aria-labelledby={`grupo-${grupo.clave}`}>
                <h2 id={`grupo-${grupo.clave}`}>{grupo.titulo}</h2>
                <p class="muted">{grupo.descripcion}</p>
                <ul class="link-list">
                  {grupo.herramientas.map((h) => (
                    <li>
                      <a href={url(ruta.herramienta(h.data.slug))}>
                        <Sprite familia="functional" nombre="calculadora" size={24} />
                        {h.data.titulo}
                        <span class="orden">{ETIQUETA_ESTADO[h.data.estado_implementacion] ?? h.data.estado_implementacion}</span>
                      </a>
                      <p>{h.data.descripcion}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          {sueltas.length > 0 && (
            <section class="v2-tools-group" aria-labelledby="grupo-otras">
              <h2 id="grupo-otras">Otras</h2>
              <ul class="link-list">
                {sueltas.map((h) => (
                  <li>
                    <a href={url(ruta.herramienta(h.data.slug))}>
                      <Sprite familia="functional" nombre="calculadora" size={24} />
                      {h.data.titulo}
                      <span class="orden">{ETIQUETA_ESTADO[h.data.estado_implementacion] ?? h.data.estado_implementacion}</span>
                    </a>
                    <p>{h.data.descripcion}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      )
    }
  </div>
</Base>

<style>
  .v2-tools-group + .v2-tools-group {
    margin-top: 2.5rem;
  }
  .v2-tools-group h2 {
    margin-bottom: 0.25rem;
  }
</style>
