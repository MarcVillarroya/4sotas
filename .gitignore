# Dependencias y artefactos de build
node_modules/
dist/
dist-fixtures/
# Build de fixtures con base raíz (SITE_BASE=/), el único servible desde file:// o :puerto raíz
# para comprobar la calculadora en el navegador. Artefacto local, nunca se publica.
dist-qa/
.astro/

# Entorno y credenciales: el token de YouTube no entra nunca al repo
.env
.env.*
*.token
yt_token.json
*.pem
*.key

# Sistema
.DS_Store
Thumbs.db
*.log

# Informes de validación locales (el de release se commitea a mano)
qa/*.local.json

# Cuerpos descargados de las fuentes citadas: material de terceros, nunca al repo
qa/f1-revision/cache/
