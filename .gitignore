# Dependencias y artefactos de build
node_modules/
dist/
dist-fixtures/
# Build de fixtures con base raíz (SITE_BASE=/), el único servible desde file:// o :puerto raíz
# para comprobar la calculadora en el navegador. Artefacto local, nunca se publica.
dist-qa/
.astro/

# Entorno y credenciales: el token de YouTube no entra nunca al repo
.env
.env.*
*.token
yt_token.json
*.pem
*.key

# Sistema
.DS_Store
Thumbs.db
*.log

# Informes de validación locales (el de release se commitea a mano)
qa/*.local.json
# Directorios temporales de tests (se crean y borran en cada ejecución)
qa/tmp-*/

# Cuerpos descargados de las fuentes citadas: material de terceros, nunca al repo
qa/f1-revision/cache/

# capturas de QA (pesadas; se regeneran con qa/f1-integral/browser-qa.mjs)
qa/**/evidence*/

# Dependencias locales (nunca en el repo)
node_modules/

# Worktrees de tareas paralelas
.worktrees/

# Capturas por ronda de QA V2 (pesadas; se regeneran con scripts/qa-v2-*.mjs).
# Solo el informe JSON de cada ronda va al repo.
qa/v2-*/*.png

# Capturas visuales locales (pesadas; se regeneran con scripts de QA visual)
qa/visual/
scratch/
